{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atimics.github.io/zero-grounded-literary-lm/schemas/corpus-sources.schema.json",
  "title": "ZERO corpus source registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dataset_id", "version", "release_date", "description", "split_seed", "splits", "documents", "deduplication", "tokenizer", "contamination_panels", "sources"],
  "properties": {
    "schema": {"const": "zero.corpus_sources.v1"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.v[0-9]+$"},
    "release_date": {"type": "string", "format": "date"},
    "description": {"type": "string", "minLength": 1},
    "split_seed": {"type": "string", "minLength": 1},
    "splits": {
      "type": "object", "additionalProperties": false,
      "required": ["train_permyriad", "validation_permyriad", "test_permyriad"],
      "properties": {
        "train_permyriad": {"type": "integer", "minimum": 1, "maximum": 9998},
        "validation_permyriad": {"type": "integer", "minimum": 1},
        "test_permyriad": {"type": "integer", "minimum": 1}
      }
    },
    "documents": {
      "type": "object", "additionalProperties": false,
      "required": ["target_utf8_bytes", "maximum_utf8_bytes", "minimum_utf8_bytes"],
      "properties": {
        "target_utf8_bytes": {"type": "integer", "minimum": 256},
        "maximum_utf8_bytes": {"type": "integer", "minimum": 256},
        "minimum_utf8_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "deduplication": {
      "type": "object", "additionalProperties": false,
      "required": ["word_shingle_size", "simhash_max_hamming_distance"],
      "properties": {
        "word_shingle_size": {"type": "integer", "minimum": 2, "maximum": 12},
        "simhash_max_hamming_distance": {"type": "integer", "minimum": 0, "maximum": 16}
      }
    },
    "tokenizer": {"$ref": "#/$defs/fileBinding"},
    "contamination_panels": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/fileBinding"},
          {"type": "object", "required": ["id", "text_column"], "properties": {"id": {"type": "string"}, "text_column": {"type": "string"}}}
        ]
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/fileBinding"},
          {
            "type": "object",
            "required": ["id", "title", "author", "origin_url", "license", "sampling_weight", "tags"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
              "title": {"type": "string", "minLength": 1},
              "author": {"type": "string", "minLength": 1},
              "origin_url": {"type": "string", "format": "uri"},
              "license": {"type": "string", "minLength": 1},
              "sampling_weight": {"type": "number", "exclusiveMinimum": 0},
              "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "vocabulary_size": {"type": "integer", "minimum": 1},
        "token_width_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
