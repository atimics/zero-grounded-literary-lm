{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atimics.github.io/zero-grounded-literary-lm/schemas/dataset-manifest.schema.json",
  "title": "ZERO immutable dataset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dataset_id", "version", "dataset_digest", "release_date", "registry", "tokenizer", "build", "sources", "splits", "quality", "artifacts"],
  "properties": {
    "schema": {"const": "zero.dataset_manifest.v1"},
    "dataset_id": {"type": "string"},
    "version": {"type": "string"},
    "dataset_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_date": {"type": "string", "format": "date"},
    "registry": {"$ref": "#/$defs/artifact"},
    "tokenizer": {"type": "object"},
    "build": {"type": "object"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "splits": {"type": "object"},
    "quality": {"type": "object"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
