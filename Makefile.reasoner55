# Development targets extend the build through this separate entry point.
# The R5.9a contract records the exact bytes of the main Makefile.
include Makefile

.PHONY: reasoner55-diagnostics reasoner55-diagnostics-check reasoner55-experiments-check
build/reasoner55_diagnostics: reasoner55_diagnostics.c reasoner55.c reasoner55.h
	mkdir -p build
	$(CC) $(CFLAGS) reasoner55_diagnostics.c -o $@

reasoner55-diagnostics: build/reasoner55_diagnostics
	node scripts/run_reasoner55_diagnostics.mjs --write

reasoner55-diagnostics-check: build/reasoner55_diagnostics
	node scripts/check_reasoner55_diagnostics.mjs

reasoner55-experiments-check: reasoner55-diagnostics-check
check: reasoner55-experiments-check

build/reasoner55_semantic_guide: reasoner55_semantic_guide.c reasoner55_diagnostics.c reasoner55.c reasoner55.h
	mkdir -p build
	$(CC) $(CFLAGS) reasoner55_semantic_guide.c -lm -o $@

.PHONY: reasoner55-semantic-guide reasoner55-semantic-guide-check
reasoner55-semantic-guide: build/reasoner55_semantic_guide
	node scripts/run_reasoner55_semantic_guide.mjs --write

reasoner55-semantic-guide-check: build/reasoner55_semantic_guide
	./build/reasoner55_semantic_guide --self-test
	node scripts/check_reasoner55_semantic_guide.mjs

reasoner55-experiments-check: reasoner55-semantic-guide-check

build/reasoner55_semantic_guide_embed.h: reasoner55_semantic_guide.c scripts/embed_reasoner55_guide.mjs
	node scripts/embed_reasoner55_guide.mjs

build/reasoner55_fixed_transfer: reasoner55_fixed_transfer.c build/reasoner55_semantic_guide_embed.h reasoner55_diagnostics.c reasoner55.c reasoner55.h
	$(CC) $(CFLAGS) -I. reasoner55_fixed_transfer.c -lm -o $@

.PHONY: reasoner55-fixed-transfer reasoner55-fixed-transfer-check
reasoner55-fixed-transfer: build/reasoner55_fixed_transfer
	node scripts/run_reasoner55_fixed_transfer.mjs --write

reasoner55-fixed-transfer-check: build/reasoner55_fixed_transfer
	./build/reasoner55_fixed_transfer --self-test
	node scripts/check_reasoner55_fixed_transfer.mjs

reasoner55-experiments-check: reasoner55-fixed-transfer-check
