  "normalization": {
    "unicode_form": "NFKD",
    "curly_quotes": "ASCII quote equivalents",
    "en_and_em_dash": "ASCII hyphen",
    "ellipsis": "three ASCII periods",
    "combining_marks": "removed",
    "remaining_non_ascii": "question mark",
    "whitespace": "collapse to one ASCII space and trim",
    "model_vocabulary": "128 normalized ASCII/control tokens"
  },
  "context_policy": {
    "model_context_characters": 512,
    "fixed_bos_surrogate": "one newline byte",
    "maximum_prepared_context_characters": 511,
    "overlength_context": "retain the rightmost 511 normalized characters",
    "continuations": "score every normalized continuation byte while the native sliding context advances"
  },
  "scoring_policy": {
    "likelihood": "negative base-2 log probability from the frozen native float-softmax API; exact zero underflow is bounded at FLT_MIN",
    "greedy_token": "temperature-zero argmax from the frozen deployed generation API over printable ASCII, newline, and message-end tokens",
    "argmax_ties": "generation API order",
    "choice_ties": "lowest choice index",
    "length_normalization": "sum of continuation bits divided by continuation bytes"
  },
  "tasks": [
    {
      "id": "blimp",
      "cases": 67000,
      "primary_metric": "raw full-sentence pair accuracy",
      "secondary_metrics": [
        "length-normalized pair accuracy",
        "accuracy by paradigm"
      ],
      "chance_accuracy": 0.5,
      "adaptation": "a fixed newline is fed as a BOS surrogate and a leading space is scored before each sentence"
    },
    {
      "id": "hellaswag",
      "cases": 10042,
      "primary_metric": "byte-length-normalized four-choice accuracy",
      "secondary_metrics": [
        "raw four-choice accuracy",
        "accuracy by split type"
      ],
      "chance_accuracy": 0.25,
      "adaptation": "EleutherAI preprocessing and target delimiter are reproduced; contexts beyond 511 normalized characters are right-truncated"
    },
    {
      "id": "lambada",
      "cases": 5153,
      "primary_metric": "greedy exact final-word accuracy",
      "secondary_metrics": [
        "target bits per byte"
      ],
      "chance_accuracy": null,
      "adaptation": "rightmost 511 normalized context characters; result is explicitly not standard full-context LAMBADA"
    },
    {
      "id": "tinystories",
      "cases": 1000,
      "primary_metric": "bits per byte",
      "secondary_metrics": [],
      "chance_accuracy": null,
      "adaptation": "1000 deterministically hash-selected validation stories, one deterministic window of at most 512 normalized characters per story"
    }
  ],
