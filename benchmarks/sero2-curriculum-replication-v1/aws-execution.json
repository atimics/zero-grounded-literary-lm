{
  "schema": "sero.curriculum_replication_aws_execution.v1",
  "region": "us-east-1",
  "instance_type": "g5.xlarge",
  "on_demand_usd_per_hour": 1.006,
  "seeds": [1, 2],
  "full": {
    "maximum_instance_seconds_per_seed": 10800,
    "maximum_ec2_usd_per_seed": 3.018,
    "maximum_ec2_usd_two_seeds": 6.036
  },
  "controls": {
    "seed0_calibration_reused": true,
    "immutable_source_archive": true,
    "immutable_dataset_digest": true,
    "automatic_instance_shutdown": true,
    "parallel_seed_instances": true,
    "consolidation_requires_seed_specific_hash_binding": true
  }
}
