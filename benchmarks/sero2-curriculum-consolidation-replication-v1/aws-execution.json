{
  "schema": "sero.curriculum_pretrain_aws_execution.v1",
  "region": "us-east-1",
  "instance_type": "g5.xlarge",
  "on_demand_usd_per_hour": 1.006,
  "seeds": [1, 2],
  "full_per_seed": {
    "maximum_instance_seconds": 7200,
    "maximum_ec2_usd": 2.012
  },
  "maximum_ec2_usd": 4.024,
  "controls": {
    "immutable_source_archive": true,
    "immutable_dataset_digest": true,
    "immutable_parent_checkpoint_by_seed": true,
    "automatic_instance_shutdown": true,
    "reuse_seed0_hardware_calibration": true,
    "seeds_1_and_2_open": true
  }
}
