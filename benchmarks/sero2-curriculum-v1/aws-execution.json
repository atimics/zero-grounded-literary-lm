{
  "schema": "sero.curriculum_pretrain_aws_execution.v1",
  "region": "us-east-1",
  "instance_type": "g5.xlarge",
  "on_demand_usd_per_hour": 1.006,
  "seed": 0,
  "calibration": {
    "maximum_updates": 128,
    "validation_raw_byte_limit": 131072,
    "maximum_instance_seconds": 1800,
    "maximum_ec2_usd": 0.503
  },
  "full": {
    "maximum_instance_seconds": 10800,
    "maximum_ec2_usd": 3.018
  },
  "pilot_maximum_ec2_usd": 3.521,
  "controls": {
    "immutable_source_archive": true,
    "immutable_dataset_digest": true,
    "automatic_instance_shutdown": true,
    "calibration_must_pass_before_full": true,
    "seeds_1_and_2_closed": true
  }
}
