{
  "schema": "sero.latent_v1_contract.v1",
  "experiment": "sero-latent-v1",
  "status": "preregistered",
  "dataset": {
    "id": "zero-literary",
    "version": "2026-08-12.v1",
    "digest": "9ac3fcfd15e9e4cea44c0b8504799c9de33672fb0561d620bc1959b27b6ec736",
    "train_glob": "build/zero-literary-v1/text/train/*.txt",
    "validation_glob": "build/zero-literary-v1/text/validation/*.txt",
    "train_byte_limit": 1048576,
    "validation_byte_limit": 131072
  },
  "static_control": {
    "algorithm": "lossless-byte-bpe",
    "vocabulary_size": 4096,
    "maximum_token_bytes": 8,
    "fit_split": "train-only"
  },
  "latent_segmenter": {
    "algorithm": "causal-next-byte-entropy",
    "embedding_dimension": 32,
    "updates": 200,
    "batch_size": 64,
    "sequence_bytes": 64,
    "learning_rate": 0.003,
    "calibration_bytes": 262144,
    "maximum_patch_bytes": 8,
    "target": "static-control-training-bytes-per-patch"
  },
  "downstream_model": {
    "local_encoder": "tied-byte-embedding-plus-gru",
    "global_model": "causal-patch-transformer",
    "local_decoder": "autoregressive-gru-with-end-patch",
    "embedding_dimension": 48,
    "attention_heads": 4,
    "transformer_layers": 2,
    "feed_forward_dimension": 128,
    "patch_context": 16,
    "updates": 300,
    "batch_size": 8,
    "learning_rate": 0.001,
    "seed": 0
  },
  "primary_metric": "validation-total-bits-per-raw-byte-including-end-patch",
  "promotion_gates": {
    "exact_roundtrip_both": true,
    "identical_downstream_parameters": true,
    "identical_patch_positions_and_decoder_slots": true,
    "training_raw_byte_ratio_minimum": 0.95,
    "training_raw_byte_ratio_maximum": 1.05,
    "validation_raw_byte_ratio_minimum": 0.99,
    "validation_raw_byte_ratio_maximum": 1.01,
    "latent_relative_bits_per_byte_maximum": 0.99
  }
